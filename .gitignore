# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyd
*.pyo
*.egg-info/
.pytest_cache/

# Django migrations (ignore all except __init__.py)
**/migrations/*
!**/migrations/__init__.py

# Virtual environment
venv/
env/
.env

# Databases
*.sqlite3
*.db
*.db-*

# Uploaded Media
media/

# Static files (if collected)
static/

# Data sources and sample data
sample_data/
data_sources/
media/data_sources/

# CSV and Excel files (be careful: this ignores ALL .csv/.xlsx files)
*.csv
*.xlsx

# Logs
*.log
*.err
*.out

# Editors and IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*~
.DS_Store

# OS files
.directory

# Coverage
.coverage
.coverage.*

# Sensitive files
*.key
*.pem
*.cert
*.conf
*.ini